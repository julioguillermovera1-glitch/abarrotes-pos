# Copia este archivo como ".env" y completa los valores.
# En una instalación nueva, Instalar.ps1 genera este archivo automáticamente.

APP_MODE=local

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=abarrotes_app
DB_PASSWORD=
DB_NAME=abarrotes_pos

SESSION_SECRET=

PORT=4001

# Solo si este local se conecta a un panel central en la nube (opcional):
# CENTRAL_URL_DEFAULT=https://tu-panel-central.onrender.com
# SYNC_INTERVAL_MINUTES=20

# Solo en modo central, para el flujo de compra (/comprar):
# FLOW_API_KEY=
# FLOW_SECRET_KEY=
# FLOW_API_URL=https://sandbox.flow.cl/api   # sin esta linea usa sandbox por defecto; produccion es https://www.flow.cl/api
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=licencias@creotuidea.cl
