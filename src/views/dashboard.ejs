<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Panel Central — Todos los locales</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-brand">🏬 Panel Central</div>
    <div class="navbar-links"></div>
    <div class="navbar-user">
      <button type="button" class="link-button" onclick="document.getElementById('modalCambiarPassword').style.display='flex'">🔑 Cambiar contraseña</button>
      <span><%= usuario.usuario %></span>
      <form method="POST" action="/logout" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="link-button">Salir</button>
      </form>
    </div>
  </nav>

  <% if (passwordPorDefecto) { %>
    <div class="alert alert-error" style="margin:1rem 1.5rem 0; border-radius:6px">
      ⚠️ Estás usando la contraseña por defecto (admin123). Cámbiala ahora con el botón "🔑 Cambiar contraseña" arriba — es de conocimiento público porque está en el código fuente.
    </div>
  <% } %>

  <main class="content">
    <div class="content-header">
      <h1><%= esSuperAdmin ? 'Resumen de todos los locales' : 'Resumen de tus locales' %></h1>
      <div style="display:flex; gap:0.6rem">
        <form method="POST" action="/api/limpiar-locales" onsubmit="return confirm('<%= esSuperAdmin ? '¿Desconectar TODOS los locales del panel (de todos los clientes)? Cada uno deberá emparejarse de nuevo con un código.' : '¿Desconectar tus locales? Cada uno deberá emparejarse de nuevo con un código.' %>')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-secondary">🧹 <%= esSuperAdmin ? 'Desconectar todos los locales' : 'Desconectar mis locales' %></button>
        </form>
        <% if (esSuperAdmin) { %>
          <button class="btn btn-secondary" onclick="document.getElementById('modalCliente').style.display='flex'">👤 Agregar cliente</button>
          <button class="btn btn-secondary" onclick="document.getElementById('modalLicencia').style.display='flex'">🔑 Generar código de activación</button>
        <% } %>
        <button class="btn btn-primary" onclick="document.getElementById('modalNuevoLocal').style.display='flex'">+ Agregar local nuevo</button>
      </div>
    </div>

    <div class="tarjetas-resumen">
      <div class="tarjeta"><h3><%= locales.length %></h3><p>Locales conectados</p></div>
      <div class="tarjeta"><h3><%= moneyCL(totales.ventas_hoy_total) %></h3><p>Ventas de hoy (todos)</p></div>
      <div class="tarjeta"><h3><%= totales.ventas_hoy_count %></h3><p>Transacciones hoy</p></div>
      <div class="tarjeta"><h3><%= moneyCL(totales.cuentas_por_pagar_total) %></h3><p>Total por pagar (todos)</p></div>
    </div>

    <% if (locales.length === 0) { %>
      <p style="margin-top:2rem; color:#888;">Todavía no se ha conectado ningún local. En cuanto un local sincronice, aparecerá aquí.</p>
    <% } %>

    <div class="locales-grid">
      <% locales.forEach(l => { %>
        <div class="local-card">
          <div class="local-card-header">
            <h2><%= l.local_nombre %></h2>
            <span class="<%= l.conectado ? 'badge-ok' : 'badge-error' %>"><%= l.conectado ? '🟢 Conectado' : '🔴 Sin conexión' %></span>
          </div>
          <span class="local-actualizado">Última sincronización: <%= new Date(l.actualizado_en).toLocaleString('es-CL') %></span>

          <% if (esSuperAdmin && l.cliente_usuario) { %>
            <p style="margin:0.4rem 0; font-size:0.9rem; color:#555">
              Cliente: <strong><%= l.cliente_nombre_contacto || l.cliente_usuario %></strong>
              <% if (l.cliente_telefono) { %> — 📞 <%= l.cliente_telefono %><% } %>
            </p>
          <% } %>

          <div class="local-stats">
            <div><strong><%= moneyCL(l.ventas_hoy_total) %></strong><span>Ventas hoy</span></div>
            <div><strong><%= l.ventas_hoy_count %></strong><span>Transacciones</span></div>
            <div><strong><%= moneyCL(l.cuentas_por_pagar_total) %></strong><span>Por pagar</span></div>
          </div>

          <details open>
            <summary>Productos más vendidos</summary>
            <table class="tabla-datos">
              <thead><tr><th>Producto</th><th>Cantidad</th></tr></thead>
              <tbody>
                <% l.top_productos.forEach(p => { %>
                  <tr><td><%= p.nombre %></td><td><%= p.cantidad %></td></tr>
                <% }) %>
                <% if (l.top_productos.length === 0) { %><tr><td colspan="2">Sin datos</td></tr><% } %>
              </tbody>
            </table>
          </details>

          <details>
            <summary>Productos con bajo stock</summary>
            <table class="tabla-datos">
              <thead><tr><th>Producto</th><th>Existencia</th><th>Mínimo</th></tr></thead>
              <tbody>
                <% l.bajo_stock.forEach(p => { %>
                  <tr class="fila-alerta"><td><%= p.nombre %></td><td><%= p.existencia %></td><td><%= p.stock_minimo %></td></tr>
                <% }) %>
                <% if (l.bajo_stock.length === 0) { %><tr><td colspan="3">Sin faltantes</td></tr><% } %>
              </tbody>
            </table>
          </details>

          <details>
            <summary>Cuentas por pagar a proveedores</summary>
            <table class="tabla-datos">
              <thead><tr><th>Proveedor</th><th>Saldo</th></tr></thead>
              <tbody>
                <% l.cuentas_por_pagar.forEach(c => { %>
                  <tr><td><%= c.proveedor %></td><td><%= moneyCL(c.saldo) %></td></tr>
                <% }) %>
                <% if (l.cuentas_por_pagar.length === 0) { %><tr><td colspan="2">Sin deudas pendientes</td></tr><% } %>
              </tbody>
            </table>
          </details>
        </div>
      <% }) %>
    </div>
  </main>

  <div id="modalNuevoLocal" class="modal">
    <div class="modal-contenido">
      <h2>Agregar local nuevo</h2>

      <div id="pasoNombre">
        <label>Nombre del local</label>
        <input type="text" id="nombreLocalNuevo" placeholder="Ej: Sucursal Talcahuano">
        <div class="modal-botones">
          <button type="button" class="btn btn-secondary" onclick="cerrarModalLocal()">Cancelar</button>
          <button type="button" class="btn btn-primary" onclick="generarCodigo()">Generar código</button>
        </div>
      </div>

      <div id="pasoCodigo" style="display:none; text-align:center">
        <p>En el POS del local nuevo, entra a <strong>"Conectar panel central"</strong> e ingresa este código
           (o escanea el QR si tienes lector). Vence en 30 minutos.</p>
        <img id="qrCodigo" alt="Código QR" style="width:200px; height:200px; margin:0.5rem 0">
        <div id="codigoTexto" style="font-size:2rem; font-weight:bold; letter-spacing:0.3rem; margin:0.5rem 0"></div>
        <div class="modal-botones" style="justify-content:center">
          <button type="button" class="btn btn-secondary" onclick="cerrarModalLocal()">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function generarCodigo() {
      const nombre = document.getElementById('nombreLocalNuevo').value;
      const res = await fetch('/api/generar-codigo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
        body: JSON.stringify({ local_nombre: nombre })
      });
      const data = await res.json();
      document.getElementById('pasoNombre').style.display = 'none';
      document.getElementById('pasoCodigo').style.display = 'block';
      document.getElementById('qrCodigo').src = data.qr;
      document.getElementById('codigoTexto').textContent = data.code;
    }
    function cerrarModalLocal() {
      document.getElementById('modalNuevoLocal').style.display = 'none';
      document.getElementById('pasoNombre').style.display = 'block';
      document.getElementById('pasoCodigo').style.display = 'none';
      document.getElementById('nombreLocalNuevo').value = '';
    }

    async function generarCodigoLicencia() {
      const nota = document.getElementById('notaLicencia').value.trim();
      const msg = document.getElementById('mensajeLicencia');
      msg.style.display = 'none';
      document.getElementById('codigoLicenciaResultado').style.display = 'none';

      const res = await fetch('/api/generar-codigo-licencia', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
        body: JSON.stringify({ nota })
      });
      const data = await res.json();
      if (!res.ok) {
        msg.textContent = data.error;
        msg.style.display = 'block';
        return;
      }
      document.getElementById('codigoLicenciaTexto').textContent = data.codigo;
      document.getElementById('codigoLicenciaResultado').style.display = 'block';
    }
    function cerrarModalLicencia() {
      document.getElementById('modalLicencia').style.display = 'none';
      document.getElementById('notaLicencia').value = '';
      document.getElementById('codigoLicenciaResultado').style.display = 'none';
      document.getElementById('mensajeLicencia').style.display = 'none';
    }

    async function crearCliente() {
      const usuario = document.getElementById('usuarioClienteNuevo').value.trim();
      const password = document.getElementById('passwordClienteNuevo').value.trim();
      const nombre_contacto = document.getElementById('nombreContactoClienteNuevo').value.trim();
      const telefono = document.getElementById('telefonoClienteNuevo').value.trim();
      const msg = document.getElementById('mensajeCliente');
      msg.style.display = 'none';
      document.getElementById('resultadoCliente').style.display = 'none';

      const res = await fetch('/api/crear-cliente', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
        body: JSON.stringify({ usuario, password, nombre_contacto, telefono })
      });
      const data = await res.json();
      if (!res.ok) {
        msg.textContent = data.error;
        msg.style.display = 'block';
        return;
      }
      document.getElementById('resultadoClienteTexto').textContent = `Usuario: ${data.usuario}  /  Contraseña: ${data.password}`;
      document.getElementById('resultadoCliente').style.display = 'block';
    }
    async function eliminarCliente(id, usuario) {
      if (!confirm(`¿Eliminar el acceso del cliente "${usuario}"? Sus locales van a seguir funcionando, solo pierde el login al panel.`)) return;
      const res = await fetch('/api/eliminar-cliente', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
        body: JSON.stringify({ cliente_id: id })
      });
      if (res.ok) location.reload();
    }
    function cerrarModalCliente() {
      document.getElementById('modalCliente').style.display = 'none';
      document.getElementById('usuarioClienteNuevo').value = '';
      document.getElementById('passwordClienteNuevo').value = '';
      document.getElementById('nombreContactoClienteNuevo').value = '';
      document.getElementById('telefonoClienteNuevo').value = '';
      document.getElementById('resultadoCliente').style.display = 'none';
      document.getElementById('mensajeCliente').style.display = 'none';
    }

    async function cambiarPassword() {
      const password_actual = document.getElementById('passwordActual').value;
      const password_nueva = document.getElementById('passwordNueva').value;
      const msg = document.getElementById('mensajeCambiarPassword');
      msg.style.display = 'none';

      const res = await fetch('/api/cambiar-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
        body: JSON.stringify({ password_actual, password_nueva })
      });
      const data = await res.json();
      if (!res.ok) {
        msg.textContent = data.error;
        msg.className = 'alert alert-error';
        msg.style.display = 'block';
        return;
      }
      location.reload();
    }
  </script>

  <div id="modalLicencia" class="modal">
    <div class="modal-contenido">
      <h2>Generar código de activación</h2>
      <p style="color:#888; font-size:0.9rem">
        Genera un código de un solo uso para vender el programa a un local cuya prueba gratis
        de 7 días terminó. El local lo valida aquí mismo al activarlo (necesita internet en ese momento).
      </p>
      <label>Nota (opcional, para tu propio registro)</label>
      <input type="text" id="notaLicencia" placeholder="Ej: Minimarket El Sol">
      <div id="codigoLicenciaResultado" style="display:none; text-align:center; margin-top:1rem">
        <p style="margin-bottom:0.3rem">Dale este código al local para que lo escriba en su menú "Licencia":</p>
        <div style="font-size:2rem; font-weight:bold; letter-spacing:0.3rem; background:white; padding:0.8rem; border-radius:6px" id="codigoLicenciaTexto"></div>
      </div>
      <div id="mensajeLicencia" class="alert alert-error" style="display:none; margin-top:1rem"></div>
      <div class="modal-botones">
        <button type="button" class="btn btn-secondary" onclick="cerrarModalLicencia()">Cerrar</button>
        <button type="button" class="btn btn-primary" onclick="generarCodigoLicencia()">Generar código</button>
      </div>
    </div>
  </div>

  <div id="modalCliente" class="modal">
    <div class="modal-contenido">
      <h2>Agregar cliente</h2>
      <p style="color:#888; font-size:0.9rem">
        Crea un usuario para que un cliente entre a su propio panel — solo va a ver y administrar
        sus propios locales, nunca los de otros clientes ni los tuyos.
      </p>
      <label>Usuario</label>
      <input type="text" id="usuarioClienteNuevo" placeholder="Ej: minimarketelsol">
      <label>Contraseña (déjalo en blanco para generar una)</label>
      <input type="text" id="passwordClienteNuevo" placeholder="Opcional">
      <label>Nombre de contacto (para soporte)</label>
      <input type="text" id="nombreContactoClienteNuevo" placeholder="Ej: Pedro González">
      <label>Teléfono (para soporte)</label>
      <input type="text" id="telefonoClienteNuevo" placeholder="Ej: +56 9 1234 5678">
      <div id="resultadoCliente" style="display:none; text-align:center; margin-top:1rem">
        <p style="margin-bottom:0.3rem">Dale estos datos al cliente para que entre a su panel:</p>
        <div style="font-size:1.1rem; font-weight:bold; background:white; padding:0.8rem; border-radius:6px" id="resultadoClienteTexto"></div>
      </div>
      <div id="mensajeCliente" class="alert alert-error" style="display:none; margin-top:1rem"></div>
      <div class="modal-botones">
        <button type="button" class="btn btn-secondary" onclick="cerrarModalCliente()">Cerrar</button>
        <button type="button" class="btn btn-primary" onclick="crearCliente()">Crear</button>
      </div>

      <% if (clientes.length > 0) { %>
        <hr style="margin:1.2rem 0">
        <p style="font-weight:bold; margin-bottom:0.5rem">Clientes existentes</p>
        <table class="tabla-datos">
          <tbody>
            <% clientes.forEach(c => { %>
              <tr>
                <td>
                  <%= c.usuario %>
                  <% if (c.nombre_contacto || c.telefono) { %>
                    <br><span style="color:#888; font-size:0.8rem"><%= c.nombre_contacto || '' %><% if (c.telefono) { %> — 📞 <%= c.telefono %><% } %></span>
                  <% } %>
                </td>
                <td style="text-align:right">
                  <button type="button" class="btn btn-secondary" onclick="eliminarCliente(<%= c.id %>, '<%= c.usuario %>')">Eliminar</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <p style="color:#888; font-size:0.8rem; margin-top:0.4rem">
          Eliminar un cliente solo borra su acceso al panel — sus locales siguen funcionando igual.
        </p>
      <% } %>
    </div>
  </div>

  <div id="modalCambiarPassword" class="modal">
    <div class="modal-contenido">
      <h2>Cambiar contraseña</h2>
      <div id="mensajeCambiarPassword" class="alert" style="display:none"></div>
      <label>Contraseña actual</label>
      <input type="password" id="passwordActual" required>
      <label>Contraseña nueva (mínimo 6 caracteres)</label>
      <input type="password" id="passwordNueva" required minlength="6">
      <div class="modal-botones">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('modalCambiarPassword').style.display='none'">Cancelar</button>
        <button type="button" class="btn btn-primary" onclick="cambiarPassword()">Guardar</button>
      </div>
    </div>
  </div>
</body>
</html>
