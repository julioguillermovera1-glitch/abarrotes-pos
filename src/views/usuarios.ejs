<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Usuarios — Abarrotes POS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav', { active: 'usuarios' }) %>

  <main class="content">
    <div class="content-header">
      <h1>Usuarios (vendedores)</h1>
      <button class="btn btn-primary" onclick="document.getElementById('modalNuevo').style.display='flex'">+ Nuevo usuario</button>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (nuevaClave) { %>
      <div class="alert alert-success">
        Contraseña para <strong><%= nuevaClave.nombre %></strong> (usuario "<%= nuevaClave.usuario %>"):
        <strong style="font-size:1.2rem; letter-spacing:0.05rem"><%= nuevaClave.password %></strong>
        — apúntala o entrégasela ahora, no se volverá a mostrar.
      </div>
    <% } %>

    <p style="color:#888; font-size:0.9rem; max-width:600px">
      Cada vendedora debe entrar con su propio usuario. Así cada venta y movimiento de inventario queda
      registrado a nombre de quien lo hizo, sin confusiones entre turnos. Las contraseñas no quedan
      guardadas en texto plano en ningún lado — si una vendedora la olvida, usa "Restablecer" para darle una nueva.
    </p>

    <table class="tabla-datos">
      <thead>
        <tr><th>Nombre</th><th>Usuario</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr>
      </thead>
      <tbody>
        <% usuarios.forEach(u => { %>
          <tr>
            <td><%= u.nombre %></td>
            <td><%= u.usuario %></td>
            <td><%= u.rol === 'admin' ? 'Administrador' : 'Vendedora/Cajera' %></td>
            <td><%= u.activo ? 'Activo' : 'Inactivo' %></td>
            <td class="acciones">
              <button class="btn-mini" onclick="abrirEditar(<%= u.id %>, '<%= u.nombre.replace(/'/g, "\\'") %>', '<%= u.rol %>')">Editar</button>
              <button class="btn-mini" onclick="abrirRestablecer(<%= u.id %>, '<%= u.nombre.replace(/'/g, "\\'") %>')">Restablecer contraseña</button>
              <form method="POST" action="/usuarios/<%= u.id %>/desactivar" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-mini btn-danger"><%= u.activo ? 'Desactivar' : 'Activar' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>

  <!-- Modal nuevo usuario -->
  <div id="modalNuevo" class="modal">
    <div class="modal-contenido">
      <h2>Nuevo usuario</h2>
      <form method="POST" action="/usuarios">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Nombre</label>
        <input type="text" name="nombre" placeholder="Ej: María González" required>
        <label>Usuario (para iniciar sesión)</label>
        <input type="text" name="usuario" placeholder="Ej: maria" required>
        <label>Contraseña (déjalo en blanco para que se genere una sola)</label>
        <input type="password" name="password" placeholder="Automática">
        <label>Rol</label>
        <select name="rol">
          <option value="cajero">Vendedora/Cajera</option>
          <option value="admin">Administrador</option>
        </select>
        <div class="modal-botones">
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('modalNuevo').style.display='none'">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal editar usuario -->
  <div id="modalEditar" class="modal">
    <div class="modal-contenido">
      <h2>Editar usuario</h2>
      <form method="POST" id="formEditar">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Nombre</label>
        <input type="text" name="nombre" id="editarNombre" required>
        <label>Rol</label>
        <select name="rol" id="editarRol">
          <option value="cajero">Vendedora/Cajera</option>
          <option value="admin">Administrador</option>
        </select>
        <label>Nueva contraseña (déjalo en blanco para no cambiarla)</label>
        <input type="password" name="password" placeholder="Sin cambios" minlength="4">
        <div class="modal-botones">
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('modalEditar').style.display='none'">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal restablecer contraseña -->
  <div id="modalRestablecer" class="modal">
    <div class="modal-contenido">
      <h2>Restablecer contraseña: <span id="restablecerNombre"></span></h2>
      <form method="POST" id="formRestablecer">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Contraseña nueva (déjalo en blanco para que se genere una sola)</label>
        <input type="password" name="password" id="restablecerPassword" placeholder="Automática">
        <div class="modal-botones">
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('modalRestablecer').style.display='none'">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function abrirEditar(id, nombre, rol) {
      document.getElementById('formEditar').action = `/usuarios/${id}/editar`;
      document.getElementById('editarNombre').value = nombre;
      document.getElementById('editarRol').value = rol;
      document.getElementById('formEditar').querySelector('[name=password]').value = '';
      document.getElementById('modalEditar').style.display = 'flex';
    }

    function abrirRestablecer(id, nombre) {
      document.getElementById('formRestablecer').action = `/usuarios/${id}/restablecer`;
      document.getElementById('restablecerNombre').textContent = nombre;
      document.getElementById('restablecerPassword').value = '';
      document.getElementById('modalRestablecer').style.display = 'flex';
    }
  </script>
</body>
</html>
