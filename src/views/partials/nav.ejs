<nav class="navbar">
  <div class="navbar-brand"><img src="<%= logoLocal %>" alt="" style="width:22px; height:22px; border-radius:5px; vertical-align:-5px; margin-right:0.3rem"><%= nombreLocal %></div>
  <div class="navbar-links">
    <a href="/ventas" class="<%= typeof active !== 'undefined' && active === 'ventas' ? 'active' : '' %>">Venta</a>
    <a href="/inventario" class="<%= typeof active !== 'undefined' && active === 'inventario' ? 'active' : '' %>">Inventario</a>
    <a href="/clientes" class="<%= typeof active !== 'undefined' && active === 'clientes' ? 'active' : '' %>">Clientes</a>
    <a href="/caja" class="<%= typeof active !== 'undefined' && active === 'caja' ? 'active' : '' %>">Caja</a>
    <% if (usuario.rol === 'admin') { %>
      <a href="/proveedores" class="<%= typeof active !== 'undefined' && active === 'proveedores' ? 'active' : '' %>">Proveedores</a>
      <a href="/reportes" class="<%= typeof active !== 'undefined' && active === 'reportes' ? 'active' : '' %>">Reportes</a>
      <a href="/usuarios" class="<%= typeof active !== 'undefined' && active === 'usuarios' ? 'active' : '' %>">Usuarios</a>
      <a href="/configuracion" class="<%= typeof active !== 'undefined' && active === 'configuracion' ? 'active' : '' %>">Configuración</a>
      <a href="/licencia" class="<%= typeof active !== 'undefined' && active === 'licencia' ? 'active' : '' %>">Licencia</a>
    <% } %>
  </div>
  <div class="navbar-user">
    <a href="/setup-sync" class="<%= typeof active !== 'undefined' && active === 'setup' ? 'active' : '' %>">🔗 Panel central</a>
    <span><%= usuario.nombre %></span>
    <form method="POST" action="/logout" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="link-button">Salir</button>
    </form>
  </div>
</nav>

<% if (passwordPorDefecto) { %>
  <div class="alert alert-error" style="margin:1rem 1.5rem 0; border-radius:6px">
    ⚠️ Estás usando la contraseña por defecto (admin123). Cámbiala ahora en
    <a href="/usuarios">Usuarios → Restablecer contraseña</a> — es de conocimiento público porque está en el código fuente.
  </div>
<% } %>

<% if (typeof diasPruebaRestantes !== 'undefined') { %>
  <div class="alert" style="margin:1rem 1.5rem 0; border-radius:6px">
    ⏳ Quedan <strong><%= diasPruebaRestantes %></strong> día<%= diasPruebaRestantes === 1 ? '' : 's' %> de prueba gratis.
    <a href="/licencia">Ver cómo activar</a>.
  </div>
<% } %>

<% if (typeof diasLicenciaRestantes !== 'undefined') { %>
  <div class="alert" style="margin:1rem 1.5rem 0; border-radius:6px">
    ⏳ Tu licencia vence en <strong><%= diasLicenciaRestantes %></strong> día<%= diasLicenciaRestantes === 1 ? '' : 's' %>.
    <a href="/licencia">Ver cómo renovar</a>.
  </div>
<% } %>
