<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Ticket #<%= venta.id %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="ticket-body">
  <div class="ticket">
    <h2><%= nombreLocal %></h2>
    <p>Ticket #<%= venta.id %></p>
    <p><%= new Date(venta.creado_en).toLocaleString('es-CL') %></p>
    <p>Atendió: <%= venta.usuario_nombre || '-' %></p>
    <% if (venta.cliente_nombre) { %><p>Cliente: <%= venta.cliente_nombre %></p><% } %>
    <hr>
    <table class="ticket-tabla">
      <% detalle.forEach(d => { %>
        <tr>
          <td><%= d.producto_nombre %>
            <%= d.tipo_venta === 'peso' ? `(${(d.cantidad/1000).toLocaleString('es-CL', {maximumFractionDigits: 3})} kg)` : `x${d.cantidad}` %>
          </td>
          <td><%= moneyCL(d.subtotal) %></td>
        </tr>
      <% }) %>
    </table>
    <hr>
    <p class="ticket-total">Total: <%= moneyCL(venta.total) %></p>
    <p>Pago: <%= venta.tipo_pago === 'credito' ? 'Crédito' : 'Efectivo' %></p>
    <% if (venta.tipo_pago === 'efectivo') { %>
      <p>Pagó con: <%= moneyCL(venta.pagado_con) %></p>
      <p>Cambio: <%= moneyCL(venta.cambio) %></p>
    <% } %>
    <hr>
    <p class="ticket-gracias">¡Gracias por su compra!</p>
    <div class="ticket-acciones">
      <button type="button" class="btn btn-primary" onclick="window.print()">🖨️ Imprimir</button>
    </div>
  </div>
  <script>
    window.addEventListener('load', () => setTimeout(() => window.print(), 300));
  </script>
</body>
</html>
